---
export interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'inverted';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit' | 'reset';
  target?: '_self' | '_blank';
  rel?: string;
  id?: string;
  ariaLabel?: string;
  ariaExpanded?: 'true' | 'false';
  ariaControls?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  target,
  rel,
  id,
  ariaLabel,
  ariaExpanded,
  ariaControls,
  class: className = '',
} = Astro.props;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  primary:
    'bg-vermilion text-bone-white border border-vermilion hover:bg-terracotta hover:border-terracotta focus-visible:outline-vermilion',
  outline:
    'bg-ivory-tile/70 text-terracotta border border-terracotta/45 hover:bg-vermilion hover:text-bone-white hover:border-vermilion focus-visible:outline-vermilion',
  inverted:
    'bg-bone-white text-vermilion border border-transparent hover:bg-ivory-tile hover:text-ink-black focus-visible:outline-bone-white',
};

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  md: 'px-6 py-3 text-[15px] leading-[1.35]',
  sm: 'px-4 py-2 text-[13px] leading-[1.35]',
};

const computedRel = target === '_blank' ? (rel ?? 'noopener noreferrer') : rel;

const baseClasses = [
  'inline-flex items-center justify-center gap-2',
  'rounded-[1440px] font-medium tracking-[-0.005em]',
  'shadow-none transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]',
  'hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.97]',
  'cursor-pointer select-none',
  'focus-visible:outline-2 focus-visible:outline-offset-2',
  variantClasses[variant],
  sizeClasses[size],
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a
      id={id}
      href={href}
      target={target}
      rel={computedRel}
      aria-label={ariaLabel}
      class={baseClasses}
    >
      <slot />
    </a>
  ) : (
    <button
      id={id}
      type={type}
      aria-label={ariaLabel}
      aria-expanded={ariaExpanded}
      aria-controls={ariaControls}
      class={baseClasses}
    >
      <slot />
    </button>
  )
}
