---
export interface Props {
  label: string;
  variant?: 'default' | 'accent' | 'inverted';
  class?: string;
}

const { label, variant = 'default', class: className = '' } = Astro.props;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  default:
    'bg-ivory-tile text-slate-tag border border-ash/70 hover:border-slate-tag',
  accent:
    'bg-vermilion text-bone-white border border-vermilion',
  inverted:
    'bg-transparent text-bone-white border border-bone-white/35 hover:border-bone-white',
};

const classes = [
  'inline-flex items-center justify-center',
  'rounded-[1440px] px-3 py-1.5',
  'text-[11px] leading-[1.2] font-medium uppercase tracking-[0.055em]',
  'whitespace-nowrap select-none transition-colors duration-250',
  variantClasses[variant],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<span class={classes}>{label}</span>
