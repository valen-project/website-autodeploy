---
import { NAV_ITEMS, SITE_INFO, getWhatsAppUrl, withBase } from '../data/site';
import PillButton from './ui/PillButton.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(href: string, current: string): boolean {
  const normalizedCurrent = current.replace(/\/+$/, '') || '/';
  const normalizedHref = href.replace(/\/+$/, '') || '/';
  return normalizedCurrent === normalizedHref;
}

const waConsultUrl = getWhatsAppUrl(
  'Halo AutoDeploy, saya ingin berkonsultasi mengenai kebutuhan solusi digital untuk usaha/instansi kami.'
);
---

<header class="w-full bg-bone-white sticky top-0 z-40">
  <div class="editorial-px py-4 flex items-center justify-between gap-4">
    <!-- Header Lockup: Circular Logo + Two-line Eyebrow -->
    <a
      href={withBase('/')}
      class="inline-flex items-center gap-3 group focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink-black"
      aria-label="AutoDeploy — Kembali ke Beranda"
    >
      <span
        class="w-9 h-9 rounded-[1440px] border border-ink-black/15 bg-bone-white flex items-center justify-center shrink-0 overflow-hidden transition-colors duration-200 group-hover:border-ink-black"
      >
        <img
          src={SITE_INFO.logoPath}
          alt="Logo AutoDeploy"
          width="24"
          height="24"
          decoding="async"
          class="w-6 h-6 object-contain mix-blend-multiply"
        />
      </span>
      <span class="hidden sm:flex flex-col type-eyebrow text-ink-black leading-[1.3]">
        <span>{SITE_INFO.eyebrowLine1}</span>
        <span class="text-graphite">{SITE_INFO.eyebrowLine2}</span>
      </span>
      <span class="sm:hidden type-eyebrow text-ink-black">
        {SITE_INFO.brandName}
      </span>
    </a>

    <!-- Primary Navigation Trigger: Pill Menu Button -->
    <PillButton
      id="nav-menu-open"
      variant="primary"
      ariaLabel="Buka menu navigasi"
      ariaExpanded="false"
      ariaControls="nav-menu-drawer"
    >
      Menu
    </PillButton>
  </div>
</header>

<!-- Full-Screen Editorial Navigation Drawer -->
<div
  id="nav-menu-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Navigasi utama AutoDeploy"
  aria-hidden="true"
  class="fixed inset-0 z-50 bg-navy-ink text-bone-white flex flex-col justify-between invisible opacity-0 pointer-events-none transition-[opacity,visibility] duration-200 overflow-y-auto"
>
  <!-- Drawer Top Chrome -->
  <div class="editorial-px py-4 flex items-center justify-between gap-4 border-b border-bone-white/15">
    <a
      href={withBase('/')}
      class="inline-flex items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bone-white"
      aria-label="AutoDeploy — Beranda"
    >
      <span
        class="w-9 h-9 rounded-[1440px] bg-bone-white flex items-center justify-center shrink-0 overflow-hidden"
      >
        <img
          src={SITE_INFO.logoPath}
          alt="Logo AutoDeploy"
          width="24"
          height="24"
          loading="lazy"
          decoding="async"
          class="w-6 h-6 object-contain mix-blend-multiply"
        />
      </span>
      <span class="flex flex-col type-eyebrow text-bone-white leading-[1.3]">
        <span>{SITE_INFO.brandName}</span>
        <span class="text-bone-white/60">{SITE_INFO.parentCompany}</span>
      </span>
    </a>

    <PillButton
      id="nav-menu-close"
      variant="inverted"
      ariaLabel="Tutup menu navigasi"
    >
      Tutup
    </PillButton>
  </div>

  <!-- Drawer Main Navigation Links (5 Pages from SITEPLAN.md) -->
  <nav class="editorial-px py-10 md:py-16 flex-1 flex flex-col justify-center" aria-label="Menu utama">
    <p class="type-eyebrow text-bone-white/55 mb-6">Navigasi Halaman</p>
    <ul class="divide-y divide-bone-white/15 border-y border-bone-white/15">
      {
        NAV_ITEMS.map((item) => {
          const active = isActive(item.href, currentPath);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'group flex items-baseline justify-between gap-4 py-4 md:py-6 transition-colors duration-200',
                  active ? 'text-signal-yellow' : 'text-bone-white hover:text-mint-wash',
                ]}
              >
                <span class="flex items-baseline gap-4 md:gap-8">
                  <span class="type-eyebrow text-bone-white/50 shrink-0">{item.number}</span>
                  <span class="type-heading font-light">{item.label}</span>
                </span>
                <span class="flex items-center gap-3 shrink-0">
                  {active && (
                    <span class="hidden sm:inline-block rounded-[1440px] bg-signal-yellow text-ink-black px-3 py-1 text-[11px] uppercase font-normal tracking-normal">
                      Aktif
                    </span>
                  )}
                  <span
                    aria-hidden="true"
                    class="text-[20px] md:text-[28px] font-light transition-transform duration-200 group-hover:translate-x-1"
                  >
                    ↗
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <!-- Drawer Footer Info & WhatsApp CTA -->
  <div class="editorial-px py-6 md:py-8 border-t border-bone-white/15 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="flex flex-col gap-1 text-[14px] leading-[1.43] text-bone-white/75 max-w-xl">
      <p class="text-bone-white">
        {SITE_INFO.headquarters} • {SITE_INFO.parentCompany}
      </p>
      <p>{SITE_INFO.address}</p>
      <p>
        WhatsApp: {SITE_INFO.phoneDisplay} • Email: {SITE_INFO.email}
      </p>
    </div>

    <div class="shrink-0">
      <PillButton
        href={waConsultUrl}
        target="_blank"
        variant="inverted"
      >
        Konsultasi WhatsApp ↗
      </PillButton>
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('nav-menu-open');
  const closeBtn = document.getElementById('nav-menu-close');
  const drawer = document.getElementById('nav-menu-drawer');

  function openDrawer() {
    if (!drawer || !openBtn) return;
    drawer.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
    drawer.classList.add('visible', 'opacity-100', 'pointer-events-auto');
    drawer.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    if (!drawer || !openBtn) return;
    drawer.classList.add('invisible', 'opacity-0', 'pointer-events-none');
    drawer.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
    drawer.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    openBtn.focus();
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeDrawer();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer?.getAttribute('aria-hidden') === 'false') {
      closeDrawer();
    }
  });
</script>
