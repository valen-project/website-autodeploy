---
import { NAV_ITEMS, SITE_INFO, getWhatsAppUrl, withBase } from '../data/site';
import PillButton from './ui/PillButton.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(href: string, current: string): boolean {
  const normalizedCurrent = current.replace(/\/+$/, '') || '/';
  const normalizedHref = href.replace(/\/+$/, '') || '/';
  return normalizedCurrent === normalizedHref;
}

const waConsultUrl = getWhatsAppUrl(
  'Halo AutoDeploy, saya ingin berkonsultasi mengenai kebutuhan solusi digital untuk usaha/instansi kami.'
);
---

<header
  id="site-header"
  data-scrolled="false"
  class="w-full bg-bone-white sticky top-0 z-40 border-b border-ash/70 transition-[background-color,border-color,backdrop-filter] duration-300"
>
  <div class="editorial-px py-3.5 flex items-center justify-between gap-4">
    <!-- Brand Lockup: Vermilion Geometric Mark + Wordmark -->
    <a
      href={withBase('/')}
      class="inline-flex items-center gap-3 group focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-vermilion"
      aria-label="AutoDeploy — Kembali ke Beranda"
    >
      <span
        class="w-9 h-9 rounded-[1440px] border border-vermilion/30 bg-ivory-tile flex items-center justify-center shrink-0 overflow-hidden transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:border-vermilion group-hover:scale-105"
      >
        <img
          src={SITE_INFO.logoPath}
          alt="Logo AutoDeploy"
          width="22"
          height="22"
          decoding="async"
          class="w-5 h-5 object-contain mix-blend-multiply"
        />
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-[var(--font-display)] font-bold text-[19px] tracking-[-0.03em] text-vermilion">
          {SITE_INFO.brandName}
        </span>
        <span class="hidden sm:inline text-[10px] uppercase tracking-[0.06em] text-graphite mt-0.5">
          {SITE_INFO.parentCompany}
        </span>
      </span>
    </a>

    <!-- Desktop Comfort Inline Navigation (5 Core Pages) -->
    <nav class="hidden lg:flex items-center gap-7" aria-label="Navigasi desktop">
      {
        NAV_ITEMS.map((item) => {
          const active = isActive(item.href, currentPath);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'editorial-link text-[13.5px] font-medium tracking-[-0.005em] transition-colors duration-200',
                active ? 'text-vermilion' : 'text-ink-black/80 hover:text-vermilion',
              ]}
            >
              {active && (
                <span class="w-1.5 h-1.5 rounded-[1440px] bg-vermilion mr-0.5" aria-hidden="true" />
              )}
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: Desktop Quick Consult + Drawer Menu Pill -->
    <div class="flex items-center gap-2.5">
      <a
        href={waConsultUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-1.5 rounded-[1440px] border border-terracotta/40 bg-ivory-tile px-4 py-2 text-[13px] font-medium text-terracotta transition-all duration-300 hover:bg-vermilion hover:text-bone-white hover:border-vermilion"
      >
        <span>Konsultasi</span>
        <span aria-hidden="true">↗</span>
      </a>

      <PillButton
        id="nav-menu-open"
        variant="primary"
        size="sm"
        ariaLabel="Buka menu navigasi"
        ariaExpanded="false"
        ariaControls="nav-menu-drawer"
      >
        Menu
      </PillButton>
    </div>
  </div>
</header>

<!-- Full-Screen Warm Terracotta & Espresso Editorial Navigation Drawer -->
<div
  id="nav-menu-drawer"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Navigasi utama AutoDeploy"
  aria-hidden="true"
  class="fixed inset-0 z-50 bg-ink-black text-bone-white flex flex-col justify-between invisible opacity-0 pointer-events-none transition-[opacity,visibility] duration-400 ease-[cubic-bezier(0.22,1,0.36,1)] overflow-y-auto"
>
  <!-- Drawer Top Chrome -->
  <div class="editorial-px py-4 flex items-center justify-between gap-4 border-b border-bone-white/15">
    <a
      href={withBase('/')}
      class="inline-flex items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bone-white"
      aria-label="AutoDeploy — Beranda"
    >
      <span
        class="w-9 h-9 rounded-[1440px] bg-bone-white flex items-center justify-center shrink-0 overflow-hidden"
      >
        <img
          src={SITE_INFO.logoPath}
          alt="Logo AutoDeploy"
          width="22"
          height="22"
          loading="lazy"
          decoding="async"
          class="w-5 h-5 object-contain mix-blend-multiply"
        />
      </span>
      <span class="flex flex-col type-eyebrow text-bone-white leading-[1.3]">
        <span>{SITE_INFO.brandName}</span>
        <span class="text-bone-white/60">{SITE_INFO.parentCompany}</span>
      </span>
    </a>

    <PillButton
      id="nav-menu-close"
      variant="inverted"
      size="sm"
      ariaLabel="Tutup menu navigasi"
    >
      Tutup
    </PillButton>
  </div>

  <!-- Drawer Main Navigation Links (5 Pages from SITEPLAN.md) -->
  <nav class="editorial-px py-10 md:py-16 flex-1 flex flex-col justify-center" aria-label="Menu utama">
    <p class="type-eyebrow text-ochre-gold mb-6">Direktori Halaman AutoDeploy</p>
    <ul class="divide-y divide-bone-white/15 border-y border-bone-white/15">
      {
        NAV_ITEMS.map((item, idx) => {
          const active = isActive(item.href, currentPath);
          return (
            <li
              class="nav-drawer-item"
              style={`transition-delay: ${60 + idx * 55}ms;`}
            >
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'group flex items-baseline justify-between gap-4 py-4 md:py-5 transition-colors duration-300',
                  active ? 'text-signal-yellow' : 'text-bone-white hover:text-terracotta-wash',
                ]}
              >
                <span class="flex items-baseline gap-4 md:gap-8 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-2">
                  <span class="type-eyebrow text-bone-white/45 shrink-0">{item.number}</span>
                  <span class="type-heading">{item.label}</span>
                </span>
                <span class="flex items-center gap-3 shrink-0">
                  {active && (
                    <span class="hidden sm:inline-block rounded-[1440px] bg-vermilion text-bone-white px-3 py-1 text-[10px] uppercase font-medium tracking-[0.06em]">
                      Halaman Ini
                    </span>
                  )}
                  <span
                    aria-hidden="true"
                    class="text-[20px] md:text-[26px] transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1 group-hover:-translate-y-1"
                  >
                    ↗
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <!-- Drawer Footer Info & WhatsApp CTA -->
  <div class="editorial-px py-6 md:py-8 border-t border-bone-white/15 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="flex flex-col gap-1 text-[13.5px] leading-[1.5] text-bone-white/75 max-w-xl">
      <p class="text-bone-white font-medium">
        {SITE_INFO.headquarters} • {SITE_INFO.parentCompany}
      </p>
      <p>{SITE_INFO.address}</p>
      <p>
        WhatsApp: {SITE_INFO.phoneDisplay} • Email: {SITE_INFO.email}
      </p>
    </div>

    <div class="shrink-0">
      <PillButton
        href={waConsultUrl}
        target="_blank"
        variant="primary"
      >
        Konsultasi WhatsApp ↗
      </PillButton>
    </div>
  </div>
</div>

<script>
  const siteHeader = document.getElementById('site-header');
  const openBtn = document.getElementById('nav-menu-open');
  const closeBtn = document.getElementById('nav-menu-close');
  const drawer = document.getElementById('nav-menu-drawer');

  function updateHeaderState() {
    if (!siteHeader) return;
    siteHeader.setAttribute('data-scrolled', window.scrollY > 20 ? 'true' : 'false');
  }

  updateHeaderState();
  window.addEventListener('scroll', updateHeaderState, { passive: true });

  function openDrawer() {
    if (!drawer || !openBtn) return;
    drawer.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
    drawer.classList.add('visible', 'opacity-100', 'pointer-events-auto');
    drawer.setAttribute('data-open', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeDrawer() {
    if (!drawer || !openBtn) return;
    drawer.setAttribute('data-open', 'false');
    drawer.classList.add('invisible', 'opacity-0', 'pointer-events-none');
    drawer.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
    drawer.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    openBtn.focus();
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);

  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeDrawer();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer?.getAttribute('aria-hidden') === 'false') {
      closeDrawer();
    }
  });
</script>
