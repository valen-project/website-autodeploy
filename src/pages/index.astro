---
import Layout from '../layouts/Layout.astro';
import PillButton from '../components/ui/PillButton.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import type { ServiceCardSurface } from '../components/ui/ServiceCard.astro';
import CategoryBadge from '../components/ui/CategoryBadge.astro';
import { SITE_INFO, getWhatsAppUrl, withBase } from '../data/site';

interface ServiceSummary {
  indexNumber: string;
  category: string;
  surface: ServiceCardSurface;
  title: string;
  description: string;
}

interface CoreValue {
  indexNumber: string;
  title: string;
  description: string;
  accentBg: string;
  accentBar: string;
  iconPath: string;
}

interface ClientSegment {
  label: string;
  featured?: boolean;
}

const waConsultUrl = getWhatsAppUrl(
  'Halo AutoDeploy, saya ingin berkonsultasi mengenai kebutuhan solusi bisnis digital sesuai skala dan anggaran usaha kami.'
);

const services: ServiceSummary[] = [
  {
    indexNumber: '01',
    category: 'Strategi',
    surface: 'teal',
    title: 'Perencanaan Konsep & Digital Business Blueprint',
    description:
      'Pemetaan kebutuhan bisnis secara menyeluruh serta penyusunan konsep bisnis dan proyek untuk menentukan prioritas solusi digital yang tepat guna.',
  },
  {
    indexNumber: '02',
    category: 'Branding',
    surface: 'powder-blue',
    title: 'Desain Kreatif (2D & 3D)',
    description:
      'Pembuatan desain grafis, desain 3D, dokumentasi visual, serta berbagai aset kreatif untuk membangun dan memperkuat identitas merek (branding).',
  },
  {
    indexNumber: '03',
    category: 'Teknologi',
    surface: 'mint',
    title: 'Pengembangan Website & Landing Page',
    description:
      'Perancangan dan pengembangan situs web maupun landing page profesional untuk mendukung kredibilitas usaha dan konversi pemasaran.',
  },
  {
    indexNumber: '04',
    category: 'Pemasaran',
    surface: 'navy',
    title: 'Digital Marketing & Digital Advertising',
    description:
      'Pengelolaan strategi pemasaran digital dan kampanye iklan berbayar (termasuk META Ads) guna memperluas jangkauan pasar secara terukur.',
  },
  {
    indexNumber: '05',
    category: 'Kecerdasan Buatan',
    surface: 'magenta',
    title: 'Optimasi Konten Berbasis AI',
    description:
      'Pemanfaatan kecerdasan buatan (Artificial Intelligence) untuk memproduksi dan mengoptimalkan konten bisnis secara lebih cepat, efektif, dan efisien.',
  },
  {
    indexNumber: '06',
    category: 'Pemberdayaan',
    surface: 'cream',
    title: 'Pelatihan & Pendampingan Digital',
    description:
      'Program pelatihan pemasaran digital dan pemanfaatan AI yang dilengkapi pedoman penggunaan agar klien dapat mengoperasikan teknologi secara mandiri.',
  },
];

const coreValues: CoreValue[] = [
  {
    indexNumber: '01',
    title: 'One-Stop Digital Solution',
    description:
      'Mengintegrasikan berbagai kebutuhan digitalisasi bisnis dalam satu layanan terpadu sehingga klien bekerja lebih efisien tanpa perlu mencari banyak penyedia jasa.',
    accentBg: 'bg-mint-wash/40',
    accentBar: 'border-t-2 border-forest-teal',
    iconPath: 'M3 8h10M8 3v10M4.5 4.5h7v7h-7z',
  },
  {
    indexNumber: '02',
    title: 'Digital Business Blueprint',
    description:
      'Mengawali setiap proyek dengan pemetaan kebutuhan bisnis agar solusi yang dirancang tepat sasaran dan selaras dengan tujuan usaha klien.',
    accentBg: 'bg-powder-blue/35',
    accentBar: 'border-t-2 border-navy-ink',
    iconPath: 'M2.5 3.5h11v9h-11zM5.5 6.5h5M5.5 9.5h3',
  },
  {
    indexNumber: '03',
    title: 'Pemberdayaan & Kemandirian',
    description:
      'Menyertakan transfer pengetahuan melalui panduan penggunaan dan pelatihan praktis dalam setiap layanan.',
    accentBg: 'bg-candy-pink/35',
    accentBar: 'border-t-2 border-magenta-bloom',
    iconPath: 'M8 2.5l5.5 3-5.5 3-5.5-3 5.5-3zM4 7.5v3.5c0 1.2 1.8 2 4 2s4-.8 4-2V7.5',
  },
  {
    indexNumber: '04',
    title: 'Transparansi & Garansi Kualitas',
    description:
      'Menjalankan kerja sama berdasarkan alur konsultasi dan kontrak (MoU) yang jelas, disertai komitmen perbaikan tanpa biaya tambahan apabila terjadi kesalahan dari pihak AutoDeploy.',
    accentBg: 'bg-signal-yellow/25',
    accentBar: 'border-t-2 border-ink-black',
    iconPath: 'M8 2L3 4.2v3.6c0 3.1 2.1 5.6 5 6.2 2.9-.6 5-3.1 5-6.2V4.2L8 2zM6 8.2l1.4 1.4 2.8-2.8',
  },
];

const marqueeColors = [
  'bg-signal-yellow',
  'bg-mint-wash',
  'bg-candy-pink',
  'bg-powder-blue',
];

const clientSegments: ClientSegment[] = [
  { label: 'UMKM', featured: true },
  { label: 'Bisnis Rintisan (Startup)' },
  { label: 'Perusahaan Swasta' },
  { label: 'Instansi Pemerintah' },
  { label: 'BUMN' },
  { label: 'Penyelenggara Acara' },
  { label: 'Perguruan Tinggi' },
  { label: 'Komunitas' },
  { label: 'Lembaga Pelatihan' },
];
---

<Layout
  title={`${SITE_INFO.brandName} — Solusi Bisnis Digital Terpadu di Era Society 5.0`}
  description="AutoDeploy adalah mitra strategis solusi bisnis digital terpadu di bawah naungan Anomia Project (PT. Anomia Digital Industry) bagi UMKM, bisnis rintisan, perusahaan, dan instansi."
  ogImage="/assets/IMG_1824.jpeg"
  ogImageAlt="Tim AutoDeploy berkolaborasi merancang solusi bisnis digital terpadu di era Society 5.0"
>
  <!-- Section 1: Hero Section -->
  <section class="w-full" aria-label="Pengantar AutoDeploy">
    <div class="editorial-px pt-10 pb-12 md:pt-16 md:pb-16">
      <p class="type-eyebrow text-graphite mb-6 md:mb-8">
        {SITE_INFO.brandName} // {SITE_INFO.tagline}
      </p>

      <h1 class="type-display font-light text-ink-black max-w-6xl">
        Solusi Bisnis Digital Terpadu di Era Society 5.0
      </h1>

      <div class="mt-8 md:mt-12 flex flex-col lg:flex-row lg:items-end justify-between gap-8">
        <p class="text-[18px] md:text-[20px] leading-[1.4] font-light text-graphite max-w-2xl">
          Mitra strategis bagi UMKM, bisnis rintisan, dan perusahaan dalam mengoptimalkan operasional serta pemasaran digital melalui integrasi kreativitas, teknologi, dan strategi.
        </p>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <PillButton href={waConsultUrl} target="_blank" variant="primary">
            Konsultasi Sekarang ↗
          </PillButton>
          <PillButton href={withBase('/services')} variant="outline">
            Jelajahi Layanan
          </PillButton>
        </div>
      </div>
    </div>

    <!-- Full-Bleed Editorial Hero Image Band -->
    <div class="w-full relative overflow-hidden rounded-none shadow-none bg-navy-ink h-[460px] sm:h-[540px] lg:h-[640px]">
      <img
        src={withBase('/assets/IMG_1824.jpeg')}
        alt="Dokumentasi kolaborasi tim AutoDeploy bersama perangkat kerja dalam merancang solusi bisnis digital"
        class="w-full h-full object-cover object-[50%_48%] rounded-none"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-black/80 via-ink-black/35 to-ink-black/10"
      />
      <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8 md:p-10">
        <p class="type-eyebrow text-bone-white/85 mb-4 md:mb-6">
          KARTASURA, SUKOHARJO — ANOMIA PROJECT
        </p>
        <p class="type-heading-sm font-light text-bone-white max-w-2xl">
          Menggabungkan kekuatan industri kreatif digital dan pemasaran modern dalam satu ekosistem layanan.
        </p>
      </div>
    </div>
    <!-- Kinetic Full-Bleed Editorial Ticker Band -->
    <div
      class="w-full bg-navy-ink text-bone-white py-4 border-y border-ink-black editorial-marquee"
      aria-label="Segmen klien dan layanan AutoDeploy"
    >
      <div class="editorial-marquee-track">
        {[0, 1].map(() => (
          <div class="flex items-center gap-8 pr-8 shrink-0">
            {clientSegments.map((seg, i) => (
              <span class="inline-flex items-center gap-3 type-eyebrow text-bone-white/90 whitespace-nowrap">
                <span
                  aria-hidden="true"
                  class:list={['w-2 h-2 rounded-[1440px]', marqueeColors[i % marqueeColors.length]]}
                />
                <span>{seg.label}</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Latar Belakang Masalah & Peran AutoDeploy -->
  <section class="editorial-px py-16 md:py-24" aria-labelledby="section-background-title">
    <p class="type-eyebrow text-graphite mb-6 md:mb-8">
      01 // LATAR BELAKANG &amp; PERAN AUTODEPLOY
    </p>

    <h2 id="section-background-title" class="type-heading font-light text-ink-black max-w-4xl">
      Bukan sekadar penyedia jasa teknis, melainkan mitra strategis transformasi usaha.
    </h2>

    <div class="mt-12 md:mt-16 pt-8 md:pt-10 border-t border-ash grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <div class="lg:col-span-5 flex flex-col gap-4">
        <p class="type-eyebrow text-graphite">Tantangan Pelaku Usaha</p>
        <p class="text-[18px] md:text-[20px] leading-[1.45] font-light text-ink-black">
          Berdiri pada tahun {SITE_INFO.foundedYear}, AutoDeploy lahir dari kepedulian terhadap banyaknya pelaku usaha konvensional—khususnya UMKM dan bisnis rintisan—yang memiliki produk berkualitas namun menghadapi kendala dalam memasarkan produk, membangun identitas merek, serta memanfaatkan teknologi digital secara optimal.
        </p>
      </div>

      <div class="lg:col-span-7 flex flex-col justify-between gap-8">
        <div class="flex flex-col gap-5 text-[16px] leading-[1.55] text-graphite max-w-2xl">
          <p>
            Keterbatasan pengetahuan, sumber daya, maupun strategi kerap membuat potensi usaha yang kuat belum terhubung secara maksimal dengan peluang pasar digital saat ini.
          </p>
          <p>
            Beroperasi di bawah naungan <span class="text-ink-black">{SITE_INFO.headquarters}</span> dalam manajemen <span class="text-ink-black">{SITE_INFO.parentCompany}</span>, AutoDeploy hadir mendampingi pelaku usaha untuk beradaptasi, tumbuh mandiri, dan berdaya saing di era Society 5.0.
          </p>
        </div>

        <div class="pt-6 border-t border-ash/60 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <p class="type-eyebrow text-graphite">
            {SITE_INFO.headquarters} • {SITE_INFO.parentCompany}
          </p>
          <PillButton href={withBase('/about')} variant="outline" size="sm">
            Kenali AutoDeploy ↗
          </PillButton>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Ringkasan 6 Layanan Utama -->
  <section class="editorial-px py-16 md:py-24 border-t border-ash/60" aria-labelledby="section-services-title">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 md:mb-14">
      <div>
        <p class="type-eyebrow text-graphite mb-4 md:mb-6">
          02 // LAYANAN UTAMA
        </p>
        <h2 id="section-services-title" class="type-heading font-light text-ink-black max-w-3xl">
          Enam bidang layanan terpadu sesuai skala dan anggaran usaha.
        </h2>
      </div>

      <div class="shrink-0">
        <PillButton href={withBase('/services')} variant="outline">
          Lihat Detail Layanan ↗
        </PillButton>
      </div>
    </div>

    <p class="text-[16px] leading-[1.5] text-graphite max-w-2xl mb-10 md:mb-12">
      AutoDeploy melayani klien dari berbagai daerah tanpa batasan lokasi dengan cakupan layanan menyeluruh dari pemetaan konsep hingga pelatihan penggunaan teknologi secara mandiri.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        services.map((service) => (
          <ServiceCard
            indexNumber={service.indexNumber}
            category={service.category}
            surface={service.surface}
            title={service.title}
            description={service.description}
            href={withBase('/services')}
            linkLabel="Detail Layanan"
          />
        ))
      }
    </div>
  </section>

  <!-- Section 4: 4 Nilai Utama (Core Values) -->
  <section class="editorial-px py-16 md:py-24 border-t border-ash/60" aria-labelledby="section-values-title">
    <p class="type-eyebrow text-graphite mb-4 md:mb-6">
      03 // NILAI UTAMA (CORE VALUES)
    </p>

    <h2 id="section-values-title" class="type-heading font-light text-ink-black max-w-4xl">
      Empat pilar kerja sama yang terarah, transparan, dan memberdayakan.
    </h2>

    <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        coreValues.map((value) => (
          <article
            class:list={[
              'rounded-none shadow-none p-7 md:p-9 flex flex-col justify-between gap-6 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1',
              value.accentBg,
              value.accentBar,
            ]}
          >
            <div class="flex items-center justify-between gap-4">
              <span class="type-eyebrow text-ink-black/70">{value.indexNumber} // PILAR UTAMA</span>
              <span class="w-9 h-9 rounded-[1440px] border border-ink-black/25 bg-bone-white/75 flex items-center justify-center shrink-0">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 16 16"
                  fill="none"
                  class="w-4 h-4 text-ink-black"
                >
                  <path
                    d={value.iconPath}
                    stroke="currentColor"
                    stroke-width="1.15"
                    stroke-linecap="square"
                    stroke-linejoin="miter"
                  />
                </svg>
              </span>
            </div>

            <div class="flex flex-col gap-3">
              <h3 class="type-heading-sm font-light text-ink-black">
                {value.title}
              </h3>
              <p class="text-[15px] md:text-[16px] leading-[1.55] text-ink-black/80">
                {value.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Section 5: Segmen Klien yang Dilayani -->
  <section class="editorial-px py-16 md:py-24 border-t border-ash/60" aria-labelledby="section-clients-title">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      <div class="lg:col-span-5">
        <p class="type-eyebrow text-graphite mb-4 md:mb-6">
          04 // SEGMEN KLIEN &amp; EKOSISTEM
        </p>

        <h2 id="section-clients-title" class="type-heading font-light text-ink-black">
          Dirancang menjangkau lintas sektor usaha dan institusi.
        </h2>

        <p class="mt-6 text-[16px] leading-[1.55] text-graphite">
          Dalam memperluas dampak dan jangkauan layanan, AutoDeploy membangun kolaborasi aktif dengan para kreator, komunitas UMKM, tenaga kreatif, dan pengembang teknologi. Melalui jaringan relasi {SITE_INFO.headquarters} dan {SITE_INFO.parentCompany}, kami menjajaki kerja sama institusional guna menjembatani pemberdayaan UMKM sekaligus menjadi pusat pelatihan digital.
        </p>

        <div class="mt-8">
          <PillButton href={withBase('/partnership')} variant="outline">
            Pelajari Kemitraan &amp; Kolaborasi ↗
          </PillButton>
        </div>
      </div>

      <div class="lg:col-span-7 lg:pt-10">
        <p class="type-eyebrow text-graphite mb-5">
          Sembilan Kategori Mitra &amp; Pengguna Layanan
        </p>

        <ul class="flex flex-wrap gap-2.5" aria-label="Daftar segmen klien yang dilayani AutoDeploy">
          {
            clientSegments.map((segment) => (
              <li>
                <CategoryBadge
                  label={segment.label}
                  variant={segment.featured ? 'accent' : 'default'}
                />
              </li>
            ))
          }
        </ul>

        <div class="mt-10 pt-8 border-t border-ash grid grid-cols-1 sm:grid-cols-2 gap-8">
          <div class="flex flex-col gap-2">
            <h3 class="type-subheading font-light text-ink-black">
              Ekosistem Kolaborasi Aktif
            </h3>
            <p class="text-[14px] leading-[1.5] text-graphite">
              Bersinergi bersama kreator, komunitas UMKM, tenaga kreatif, dan pengembang teknologi untuk mendorong pemberdayaan generasi muda.
            </p>
          </div>

          <div class="flex flex-col gap-2">
            <h3 class="type-subheading font-light text-ink-black">
              Jaringan Kemitraan Institusional
            </h3>
            <p class="text-[14px] leading-[1.5] text-graphite">
              Menjalin kerja sama dengan instansi pemerintah, BUMN, dan perusahaan swasta bagi program pemberdayaan UMKM serta pusat pelatihan digital.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: CTA Penutup -->
  <section class="editorial-px py-16 md:py-24" aria-labelledby="section-cta-title">
    <div class="w-full bg-navy-ink text-bone-white rounded-none shadow-none p-8 sm:p-12 md:p-16 lg:p-20">
      <p class="type-eyebrow text-bone-white/65 mb-6">
        05 // KONSULTASI &amp; PEMETAAN KEBUTUHAN
      </p>

      <h2 id="section-cta-title" class="type-display-sm font-light text-bone-white max-w-4xl">
        Diskusikan kebutuhan digitalisasi sesuai skala dan anggaran usaha Anda.
      </h2>

      <p class="mt-6 text-[16px] md:text-[18px] leading-[1.5] font-light text-bone-white/80 max-w-2xl">
        Setiap kerja sama dimulai dari konsultasi transparan mengenai syarat dan ketentuan serta penyusunan Digital Business Blueprint. Hubungi {SITE_INFO.contactPerson} ({SITE_INFO.contactRole}) melalui WhatsApp resmi {SITE_INFO.phoneDisplay}.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <PillButton href={waConsultUrl} target="_blank" variant="inverted">
          Konsultasi via WhatsApp ↗
        </PillButton>
        <a
          href={withBase('/contact')}
          class="inline-flex items-center justify-center gap-2 rounded-[1440px] px-6 py-3 text-[16px] leading-[1.4] font-normal tracking-[-0.018em] border border-bone-white/40 text-bone-white shadow-none transition-colors duration-200 hover:border-bone-white hover:bg-bone-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bone-white"
        >
          Halaman Kontak &amp; Formulir
        </a>
      </div>
    </div>
  </section>
</Layout>
