---
import Layout from '../layouts/Layout.astro';
import PillButton from '../components/ui/PillButton.astro';
import CategoryBadge from '../components/ui/CategoryBadge.astro';
import { SITE_INFO, getWhatsAppUrl, withBase } from '../data/site';

interface MissionItem {
  number: string;
  title: string;
  description: string;
  accentBg: string;
  accentBorder: string;
  numColor: string;
}

interface LeaderItem {
  number: string;
  code: string;
  initials: string;
  role: string;
  name: string;
  focus: string;
  monogramClass: string;
}

const missions: MissionItem[] = [
  {
    number: '01',
    title: 'Solusi Digital Praktis & Terjangkau',
    description:
      'Menyediakan solusi digital yang praktis, terarah, dan terjangkau sesuai dengan kondisi, prioritas, serta anggaran masing-masing pelaku usaha.',
    accentBg: 'bg-ivory-tile',
    accentBorder: 'border border-ash/70 border-t-2 border-t-vermilion',
    numColor: 'text-vermilion',
  },
  {
    number: '02',
    title: 'Perluasan Akses Teknologi & Kreativitas',
    description:
      'Membuka akses yang lebih luas terhadap pemanfaatan teknologi modern, kreativitas, dan pengetahuan bisnis digital bagi pelaku usaha di berbagai daerah.',
    accentBg: 'bg-ivory-tile',
    accentBorder: 'border border-ash/70 border-t-2 border-t-slate-tag',
    numColor: 'text-slate-tag',
  },
  {
    number: '03',
    title: 'Pendampingan & Kemandirian Klien',
    description:
      'Memberikan pendampingan, pelatihan, dan panduan penggunaan teknologi agar klien mampu mengelola aset dan proses digitalnya secara mandiri.',
    accentBg: 'bg-ivory-tile',
    accentBorder: 'border border-ash/70 border-t-2 border-t-terracotta',
    numColor: 'text-terracotta',
  },
  {
    number: '04',
    title: 'Pemberdayaan Generasi Muda',
    description:
      'Memberdayakan generasi muda melalui penciptaan peluang kerja, ruang kolaborasi, dan pengembangan keterampilan di bidang kreatif, teknologi, serta pemasaran digital.',
    accentBg: 'bg-ivory-tile',
    accentBorder: 'border border-ash/70 border-t-2 border-t-ochre-gold',
    numColor: 'text-terracotta',
  },
];

const leadershipTeam: LeaderItem[] = [
  {
    number: '01',
    code: 'CEO',
    initials: 'AH',
    role: 'Chief Executive Officer (CEO)',
    name: 'Affan Abdul Hanan',
    focus:
      'Memimpin arah visi strategis perusahaan, pengembangan kemitraan bisnis, serta menjembatani kolaborasi dengan UMKM, korporasi, dan instansi.',
    monogramClass: 'bg-vermilion text-bone-white',
  },
  {
    number: '02',
    code: 'CTO',
    initials: 'VF',
    role: 'Chief Technical Officer (CTO)',
    name: 'Valentino Freiazeva',
    focus:
      'Bertanggung jawab atas arsitektur teknologi, pengembangan website dan landing page, serta integrasi sistem berbasis kecerdasan buatan (AI).',
    monogramClass: 'bg-slate-tag text-bone-white',
  },
  {
    number: '03',
    code: 'CCO',
    initials: 'SR',
    role: 'Chief Creative Officer (CCO)',
    name: 'Safira Brillianty Permata Ranny',
    focus:
      'Mengelola arah kreatif, identitas visual merek (branding), produksi desain grafis 2D & 3D, serta kualitas aset kampanye digital.',
    monogramClass: 'bg-terracotta text-bone-white',
  },
  {
    number: '04',
    code: 'CFO',
    initials: 'NS',
    role: 'Chief Finance Officer (CFO)',
    name: 'Nandhifa Lunandita Syahira',
    focus:
      'Mengatur perencanaan keuangan, penyusunan struktur anggaran layanan yang terjangkau bagi klien, serta pengelolaan arus kas perusahaan.',
    monogramClass: 'bg-ochre-gold text-ink-black',
  },
  {
    number: '05',
    code: 'HR',
    initials: 'MR',
    role: 'Human Resource (HR)',
    name: 'Muhammad Saad Riyanto',
    focus:
      'Mengelola pengembangan talenta internal, rekrutmen kolaborator muda, serta koordinasi program pendampingan dan pelatihan klien.',
    monogramClass: 'bg-ink-black text-bone-white',
  },
];

const waConsultUrl = getWhatsAppUrl(
  'Halo AutoDeploy, saya ingin berkonsultasi mengenai kebutuhan solusi bisnis digital untuk usaha/instansi kami.'
);
---

<Layout
  title="Tentang Kami — AutoDeploy (PT. Anomia Digital Industry)"
  description="Profil perusahaan AutoDeploy, naungan korporasi Anomia Project (PT. Anomia Digital Industry), rekam jejak Program Inovasi Kewirausahaan UMS 2026, visi & misi, serta 5 jajaran pimpinan inti."
  ogImage="/assets/head.jpeg"
  ogImageAlt="Lima jajaran pimpinan inti AutoDeploy di bawah naungan Anomia Project dan PT. Anomia Digital Industry"
>
  <!-- Page Header & Section 1: Profil & Naungan Korporasi -->
  <section class="w-full pt-10 pb-16 md:pt-16 md:pb-24">
    <div class="editorial-px">
      <!-- Page Eyebrow & Oversized Poster Headline -->
      <div class="flex flex-col gap-6 md:gap-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <p class="type-eyebrow text-graphite">
            TENTANG KAMI // PROFIL PERUSAHAAN
          </p>
          <div class="flex flex-wrap items-center gap-2">
            <CategoryBadge label={`BERDIRI ${SITE_INFO.foundedYear}`} variant="default" />
            <CategoryBadge label="ERA SOCIETY 5.0" variant="accent" />
          </div>
        </div>

        <h1 class="type-display text-terracotta max-w-5xl">
          Tentang Kami:<br />
          Mitra Strategis Transformasi Digital
        </h1>

        <p class="type-subheading text-graphite max-w-3xl">
          {SITE_INFO.brandName} ({SITE_INFO.tagline}) mengintegrasikan kreativitas, teknologi, dan
          strategi pemasaran untuk mendampingi UMKM, bisnis rintisan, maupun perusahaan tumbuh
          mandiri dan berdaya saing.
        </p>
      </div>

      <!-- Editorial Spread: Story, Corporate Umbrella & Team Documentary Photo -->
      <div class="mt-14 md:mt-20 pt-10 md:pt-14 border-t border-ash grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-12 items-start">
        <!-- Left Column: Narrative & Official Institutional Facts -->
        <div class="lg:col-span-7 flex flex-col gap-10">
          <div class="flex flex-col gap-6">
            <p class="type-eyebrow text-graphite">
              01 // IDENTITAS &amp; LATAR BELAKANG
            </p>
            <h2 class="type-heading-sm text-ink-black">
              Lahir dari Kepedulian terhadap Daya Saing Pelaku Usaha Konvensional
            </h2>
            <div class="flex flex-col gap-5 text-[16px] leading-[1.6] text-ink-black">
              <p>
                <span class="text-ink-black">AutoDeploy</span> adalah usaha yang bergerak di bidang
                solusi bisnis digital terpadu dengan mengintegrasikan kreativitas, teknologi, dan
                strategi pemasaran untuk membantu pelaku usaha mengoptimalkan operasional serta
                pengembangan bisnis di era digital. Beroperasi di bawah naungan{' '}
                <span class="text-ink-black">Anomia Project</span> sebagai kantor pusat (<em>Headquarters</em>)
                di dalam manajemen <span class="text-ink-black">{SITE_INFO.parentCompany}</span>,
                AutoDeploy menggabungkan kekuatan industri kreatif digital dan pemasaran modern dalam
                satu ekosistem layanan.
              </p>
              <p class="text-graphite">
                Berdiri pada tahun {SITE_INFO.foundedYear}, AutoDeploy lahir dari kepedulian
                terhadap banyaknya pelaku usaha konvensional—khususnya UMKM dan bisnis
                rintisan—yang memiliki produk berkualitas namun menghadapi kendala dalam memasarkan
                produk, membangun identitas merek, serta memanfaatkan teknologi digital secara
                optimal akibat keterbatasan pengetahuan, sumber daya, maupun strategi. AutoDeploy
                hadir bukan sekadar sebagai penyedia jasa teknis, melainkan sebagai mitra strategis
                yang mendampingi pelaku usaha beradaptasi, tumbuh mandiri, dan berdaya saing di era{' '}
                <em>Society 5.0</em>.
              </p>
            </div>
          </div>

          <!-- Corporate Umbrella & Official Entrepreneurship Track Record -->
          <div class="border-t border-ash divide-y divide-ash">
            <div class="py-6 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6">
              <p class="sm:col-span-4 type-eyebrow text-graphite pt-1">
                Naungan Korporasi
              </p>
              <p class="sm:col-span-8 text-[15px] leading-[1.55] text-ink-black">
                Beroperasi di bawah naungan Anomia Project sebagai <em>Headquarters</em> dalam
                manajemen {SITE_INFO.parentCompany}.
              </p>
            </div>

            <div class="py-6 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6">
              <p class="sm:col-span-4 type-eyebrow text-graphite pt-1">
                Rekam Jejak Kewirausahaan
              </p>
              <p class="sm:col-span-8 text-[15px] leading-[1.55] text-ink-black">
                Bagian dari Program Inovasi Kewirausahaan (Bidang Lomba Inovasi Kewirausahaan Non
                Digital – Tahap Bertumbuh) Tahun 2026, Program Studi Bisnis Digital, Universitas
                Muhammadiyah Surakarta.
              </p>
            </div>

            <div class="py-6 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-6">
              <p class="sm:col-span-4 type-eyebrow text-graphite pt-1">
                Standar Kerja Sama
              </p>
              <p class="sm:col-span-8 text-[15px] leading-[1.55] text-graphite">
                Setiap kerja sama dimulai dengan konsultasi transparan mengenai syarat dan ketentuan
                (<em>Terms &amp; Conditions</em>), diikat dalam perjanjian kontrak atau{' '}
                <em>Memorandum of Understanding</em> (MoU), serta dilengkapi panduan penggunaan pada
                setiap hasil pekerjaan.
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Editorial Documentary Photo of 5 Core Team Members -->
        <figure class="lg:col-span-5 flex flex-col gap-3 p-3 bg-ivory-tile border border-ash">
          <div class="w-full aspect-[4/5] overflow-hidden bg-bone-white">
            <img
              src={withBase('/assets/head.jpeg')}
              alt="Dokumentasi lima pimpinan inti AutoDeploy"
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover object-[50%_26%]"
            />
          </div>
          <figcaption class="flex items-baseline justify-between gap-4 px-1 pt-1">
            <span class="type-eyebrow text-terracotta">
              DOKUMENTASI 5 TIM INTI AUTODEPLOY
            </span>
            <span class="type-eyebrow text-graphite shrink-0">
              ANOMIA PROJECT // 2026
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Section 2: Visi & Misi -->
  <section class="w-full py-16 md:py-24 border-t border-ash">
    <div class="editorial-px">
      <!-- Section Title Block -->
      <div class="flex flex-col gap-5 max-w-4xl">
        <p class="type-eyebrow text-graphite">
          02 // VISI &amp; MISI PERUSAHAAN
        </p>
        <h2 class="type-heading text-terracotta">
          Visi &amp; Misi:<br />
          Arah Strategis Pemberdayaan
        </h2>
      </div>

      <!-- Featured Studio Ivory Contrast Block (Visi) + Documentary Accent Image -->
      <div class="mt-12 md:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        <!-- Visi Card: Warm Studio Ivory with Vermilion Top Accent -->
        <div class="lg:col-span-7 bg-ivory-tile text-ink-black border border-ash border-t-4 border-t-vermilion p-8 md:p-12 lg:p-14 flex flex-col justify-between gap-10">
          <div class="flex items-center justify-between gap-4">
            <p class="type-eyebrow text-vermilion">
              VISI PERUSAHAAN
            </p>
            <CategoryBadge label="TUJUAN UTAMA" variant="accent" />
          </div>

          <blockquote class="type-manifesto">
            “Menjadi mitra strategis bagi UMKM, bisnis rintisan, maupun perusahaan dalam menghadapi
            perkembangan teknologi dan memenangkan persaingan pasar di era digitalisasi.”
          </blockquote>

          <div class="pt-6 border-t border-ash/70 flex flex-wrap items-center justify-between gap-4">
            <p class="type-eyebrow text-graphite">
              {SITE_INFO.brandName} // {SITE_INFO.parentCompany}
            </p>
            <p class="type-eyebrow text-terracotta">
              {SITE_INFO.headquarters}
            </p>
          </div>
        </div>

        <!-- Documentary Accent Photo -->
        <figure class="lg:col-span-5 flex flex-col gap-3 p-3 bg-ivory-tile border border-ash">
          <div class="w-full flex-1 min-h-[320px] sm:min-h-[380px] lg:min-h-0 aspect-[4/5] lg:aspect-auto overflow-hidden bg-bone-white">
            <img
              src={withBase('/assets/IMG_3103.jpeg')}
              alt="Dokumentasi kolaborasi tim AutoDeploy"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-[50%_80%]"
            />
          </div>
          <figcaption class="type-eyebrow text-terracotta px-1 pt-1">
            KOLABORASI &amp; PERENCANAAN — AUTODEPLOY
          </figcaption>
        </figure>
      </div>

      <!-- Misi: 4 Numbered Pillars -->
      <div class="mt-16 md:mt-24">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-8 border-b border-ash">
          <div class="flex flex-col gap-2">
            <p class="type-eyebrow text-graphite">
              MISI PERUSAHAAN // 01 — 04
            </p>
            <h3 class="type-heading-sm text-ink-black">
              Empat Langkah Nyata Mendukung Pertumbuhan Klien
            </h3>
          </div>
          <p class="text-[14px] leading-[1.43] text-graphite max-w-sm">
            Dirancang agar pemanfaatan teknologi berjalan relevan, terjangkau, dan berkelanjutan.
          </p>
        </div>

        <ol class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            missions.map((mission) => (
              <li
                class:list={[
                  'p-7 md:p-9 rounded-none flex flex-col justify-between gap-5 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1',
                  mission.accentBg,
                  mission.accentBorder,
                ]}
              >
                <div class="flex items-center justify-between gap-4">
                  <span class:list={['type-eyebrow', mission.numColor]}>
                    MISI {mission.number}
                  </span>
                  <span class="w-2.5 h-2.5 rounded-[1440px] bg-ink-black/25" aria-hidden="true" />
                </div>
                <div class="flex flex-col gap-3">
                  <h4 class="type-heading-sm text-ink-black">
                    {mission.title}
                  </h4>
                  <p class="text-[15px] md:text-[16px] leading-[1.55] text-ink-black/80">
                    {mission.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Section 3: Jajaran Pimpinan Inti (C-Level) -->
  <section class="w-full py-16 md:py-24 border-t border-ash">
    <div class="editorial-px">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-12 md:mb-16">
        <div class="lg:col-span-7 flex flex-col gap-5">
          <p class="type-eyebrow text-graphite">
            03 // STRUKTUR ORGANISASI &amp; TIM INTI
          </p>
          <h2 class="type-heading text-terracotta">
            Tim Inti:<br />
            Jajaran Pimpinan (C-Level)
          </h2>
        </div>

        <p class="lg:col-span-5 text-[16px] leading-[1.55] text-graphite">
          Untuk memastikan setiap proyek berjalan secara profesional, terukur, dan terarah,
          AutoDeploy dikelola oleh jajaran pimpinan inti (<em>C-Level</em>) dengan pembagian
          tanggung jawab strategis sebagai berikut.
        </p>
      </div>

      <!-- Editorial Roster Table / List (5 Leaders, Chromatic Initial Monograms) -->
      <ol class="border-y border-ash divide-y divide-ash">
        {
          leadershipTeam.map((leader) => (
            <li class="editorial-row py-8 md:py-9 px-2 md:px-4 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-center">
              <div class="md:col-span-1 flex items-center justify-between md:justify-start gap-3">
                <span
                  aria-hidden="true"
                  class:list={[
                    'w-11 h-11 rounded-none flex items-center justify-center text-[13px] font-normal tracking-wider shrink-0',
                    leader.monogramClass,
                  ]}
                >
                  {leader.initials}
                </span>
                <span class="md:hidden">
                  <CategoryBadge label={leader.code} variant="default" />
                </span>
              </div>

              <div class="md:col-span-4 flex flex-col gap-1">
                <h3 class="text-[24px] md:text-[28px] leading-[1.2] tracking-[-0.02em] font-medium text-ink-black">
                  {leader.name}
                </h3>
                <p class="text-[14px] leading-[1.43] text-graphite">
                  {leader.role}
                </p>
              </div>

              <div class="hidden md:flex md:col-span-2 items-center">
                <CategoryBadge label={leader.code} variant="default" />
              </div>

              <p class="md:col-span-5 text-[15px] md:text-[16px] leading-[1.55] text-ink-black/85">
                {leader.focus}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Closing CTA Band -->
  <section class="w-full py-16 md:py-24 border-t border-ash">
    <div class="editorial-px">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
        <div class="lg:col-span-8 flex flex-col gap-5">
          <p class="type-eyebrow text-graphite">
            LANGKAH SELANJUTNYA // LAYANAN &amp; KONSULTASI
          </p>
          <h2 class="type-heading text-terracotta">
            Siap Berdiskusi Bersama Tim AutoDeploy?
          </h2>
          <p class="text-[16px] leading-[1.55] text-graphite max-w-2xl">
            Pelajari enam bidang layanan digital terpadu kami atau mulai konsultasi langsung untuk
            memetakan kebutuhan usaha dan instansi Anda.
          </p>
        </div>

        <div class="lg:col-span-4 flex flex-wrap lg:justify-end items-center gap-3">
          <PillButton href={waConsultUrl} target="_blank" variant="primary">
            Konsultasi WhatsApp ↗
          </PillButton>
          <PillButton href={withBase('/services')} variant="outline">
            Lihat Layanan →
          </PillButton>
        </div>
      </div>
    </div>
  </section>
</Layout>
